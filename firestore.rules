rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── users/{userId} ──────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── households/{hid} ───────────────────────────────────────────────────
    match /households/{hid} {
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberIds;

      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;

      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.ownerId;

      // ── households/{hid}/members/{mid} ──────────────────────────────────
      match /members/{mid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.memberIds;

        allow write: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/households/$(hid)).data.ownerId;
      }

      // ── households/{hid}/bills/{bid} ────────────────────────────────────
      match /bills/{bid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.memberIds;

        allow create, update: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/households/$(hid)).data.ownerId;

        allow delete: if false;
      }

      // ── households/{hid}/payments/{pid} ─────────────────────────────────
      match /payments/{pid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.memberIds;

        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.memberIds
          && request.resource.data.fromUserId == request.auth.uid;

        allow update, delete: if false;
      }

      // ── households/{hid}/reminders/{rid} ────────────────────────────────
      match /reminders/{rid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.memberIds;

        allow write: if false;
      }
    }

    // ── catch-all: deny everything else ────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
